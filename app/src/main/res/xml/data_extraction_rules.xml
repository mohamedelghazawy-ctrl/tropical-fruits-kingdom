<!-- النسخ الاحتياطي السحابي ونقل الجهاز (Android 12+): تقدّم اللاعب فقط -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="tropical_crush_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="tropical_crush_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
